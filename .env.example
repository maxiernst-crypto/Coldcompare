# ---- Required ----
# PostgreSQL connection string (Supabase: Project Settings → Database → Connection string, use the pooled "Transaction" URL on Vercel)
DATABASE_URL=postgres://coldcompare:coldcompare@localhost:5432/coldcompare
# Long random string used to sign admin session cookies (openssl rand -base64 48)
AUTH_SECRET=change-me-to-a-long-random-string
# Canonical public origin, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Content workflow ----
# When "true", content in "review" status is rendered (with a visible preview banner and noindex).
# Keep "false" in production: only editor-approved ("published") content is public.
CONTENT_PREVIEW=true

# ---- First admin (used by `npm run db:seed` / `npm run admin:create`) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please-123

# ---- Analytics (all optional; nothing loads unless set) ----
# GA4 loads only after the visitor accepts analytics cookies
NEXT_PUBLIC_GA_ID=
# Cookieless, privacy-friendly alternative (Plausible-compatible script)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# Google Search Console HTML-tag verification token
NEXT_PUBLIC_GSC_VERIFICATION=

# ---- Jobs ----
# Bearer token Vercel Cron sends to /api/cron/* (Vercel sets this automatically when CRON_SECRET is defined)
CRON_SECRET=

# ---- Newsletter (optional double opt-in email provider) ----
# If unset, confirmation links are logged to the server console (development only).
RESEND_API_KEY=
NEWSLETTER_FROM=
